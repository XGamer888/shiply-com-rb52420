               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Aurel Balaiu (the escrow agent),</photoshop:LayerName>
                  <photoshop:LayerText>Aurel Balaiu (the escrow agent),</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Contract date: 04, june 2025</photoshop:LayerName>
                  <photoshop:LayerText>Contract date: 04, june 2025</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>This escrow agreement dated June 4, 2025, is made and entered i</photoshop:LayerName>
                  <photoshop:LayerText>This escrow agreement dated June 4, 2025, is made and entered into by and between:</photoshop:LayerText>
               </rdf:li>
